    "## Fixed Size Chunking:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "text= \"\"\"This is the simple test \"\"\"\n",
    "\n",
    "\n",
    "def fixed_size_chunking(text, chunk_size=45):\n",
    "    return [text[i:i+chunk_size] for i in range(0, len(text), chunk_size)]\n",
    "\n",
    "chunks_fixed = fixed_size_chunking(text=text)\n",
    "print(chunks_fixed[0])"
   ]
